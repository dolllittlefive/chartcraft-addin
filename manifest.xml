      <bt:ShortStrings>
        <bt:String id="CC.Tab.Label" DefaultValue="ChartCraft"/>
        <bt:String id="CC.G0.Label" DefaultValue="比较"/>
<bt:String id="CC.C0.Label" DefaultValue="达成差额柱形图"/>
<bt:String id="CC.C1.Label" DefaultValue="子弹图"/>
<bt:String id="CC.C2.Label" DefaultValue="蝴蝶图"/>
<bt:String id="CC.C3.Label" DefaultValue="柱线与柱钉图"/>
<bt:String id="CC.C4.Label" DefaultValue="偏差图"/>
<bt:String id="CC.C5.Label" DefaultValue="滑珠/哑铃图"/>
<bt:String id="CC.G1.Label" DefaultValue="项目与进度"/>
<bt:String id="CC.C6.Label" DefaultValue="甘特图"/>
<bt:String id="CC.C7.Label" DefaultValue="涨跌箭头与同比柱"/>
<bt:String id="CC.C8.Label" DefaultValue="棒棒糖图"/>
<bt:String id="CC.C9.Label" DefaultValue="矩阵气泡图"/>
<bt:String id="CC.C10.Label" DefaultValue="多段条形/多层柱形"/>
<bt:String id="CC.G2.Label" DefaultValue="构成与累计"/>
<bt:String id="CC.C11.Label" DefaultValue="帕累托图"/>
<bt:String id="CC.C12.Label" DefaultValue="斜率图"/>
<bt:String id="CC.C13.Label" DefaultValue="堆积增强图"/>
<bt:String id="CC.C14.Label" DefaultValue="三数量级组合图"/>
<bt:String id="CC.C15.Label" DefaultValue="不等宽柱与条形"/>
<bt:String id="CC.G3.Label" DefaultValue="变化与分解"/>
<bt:String id="CC.C16.Label" DefaultValue="瀑布图"/>
        <bt:String id="CC.GetStarted.Title" DefaultValue="ChartCraft 已就绪"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="CC.C0.Tip" DefaultValue="选择含表头的三列：分类、计划（目标）、实际。差额分析：完成/未完成分色实际柱＋计划短横线＋上层差额柱；完成进度：已完成/未完成/超额堆积柱＋完成率三角；上下对比：完成率以100%为基线上下分色。"/>
<bt:String id="CC.C1.Tip" DefaultValue="选择含表头的 4–7 列：分类、窄条值、参考刻线（可空）、1–4 个递增背景上限。原例按“类别、前2年、前10年、疫情后”排列；百分比按 6.0 表示 6.0%。"/>
<bt:String id="CC.C2.Tip" DefaultValue="首行为表头：分类、左侧1–4列、右侧1–4列，可选中立项及末列独立计数；或4列：左分类、左值、右分类、右值。输入非负数字，整行留空可分组。公式自动联动，重绑保留格式。"/>
<bt:String id="CC.C3.Tip" DefaultValue="首行为表头：分类、之前、之后。PDF221 版式的输入约定：43 代表 43%。独立第三指标模式另选第 4 列；单柱＋线为分类、柱值、线值。"/>
<bt:String id="CC.C4.Tip" DefaultValue="三列含表头：分类、基期/目标、本期/实际。两列数值均须非负；差异额=本期−基期，差异率=差异额÷基期。基期0的率显示—。"/>
<bt:String id="CC.C5.Tip" DefaultValue="含表头：三列（分类、系列A、系列B）生成水平哑铃或纵向滑珠，两点连线比较两组数据；两列（分类、完成率小数）生成进度滑珠柱。改源数据自动联动。"/>
<bt:String id="CC.C6.Tip" DefaultValue="含表头3–5列：任务、开始日期、结束日期或持续天数，可加完成率(0–1)和责任人。日期须为Excel日期数值；结束不含当日，0天保留零长度。源值由公式自动重算。"/>
<bt:String id="CC.C7.Tip" DefaultValue="首行为表头。两期：分类、基期、本期（3 列）；三年：分类、第1年、第2年、第3年（4 列）。各期数值须非负。"/>
<bt:String id="CC.C8.Tip" DefaultValue="含表头：两列（分类、数值）生成等大圆点；三至四列（分类、增长率小数、规模、可选分组）生成原生气泡棒棒糖，支持2–15项。增长率按27%=0.27输入；修改绑定数值自动重算。"/>
<bt:String id="CC.C9.Tip" DefaultValue="行列矩阵：首行列名、首列行名，其余非负数；两列“名称、数值”可用城市/项目网格。改数与标签由Excel公式更新。"/>
<bt:String id="CC.C10.Tip" DefaultValue="第一列分类，其后2–8列为各系列数值（含表头，非负）。每个系列占一段（条形）或一层（柱形），同轴对齐。"/>
<bt:String id="CC.C11.Tip" DefaultValue="选中两列数据（首行为表头：分类、数值），生成原生 Excel 图表。数值修改后图表自动更新，无需本插件。"/>
<bt:String id="CC.C12.Tip" DefaultValue="首列分类，其后 2–12 期数值，首行为表头。百分比输入用 0.46 表示 46%。原生线条、端点和变化标签随单元格自动重算；多期变化比较首末两期。"/>
<bt:String id="CC.C13.Tip" DefaultValue="第一列为分类（连体柱为期间，如年份），其后1–10列为堆积分段数值（非负，可留空）。变体：堆积柱＋顶部合计、补全堆积条形、连体面积柱形；可按选区增删行。"/>
<bt:String id="CC.C14.Tip" DefaultValue="4 列含表头：分类、底部柱指标（≥0）、折线指标、顶部指标（气泡/顶部柱，≥0）。三个指标数量级不同也能同图呈现。"/>
<bt:String id="CC.C15.Tip" DefaultValue="选择分类、宽度权重和数值。宽度与高度分别随源数据重算；堆积可追加数值列，普通变体支持正负值。"/>
<bt:String id="CC.C16.Tip" DefaultValue="选择分类、1–8列数值，可选末列“类型”（变化/总计/小计）。有类型列时以该列为准；细分正负值围绕同一累计起点展开。"/>
        <bt:String id="CC.GetStarted.Description" DefaultValue="在“ChartCraft”选项卡选择图表开始。"/>
      </bt:LongStrings>
